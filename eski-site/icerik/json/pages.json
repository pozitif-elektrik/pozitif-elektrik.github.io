g\/wp-content\/uploads\/2014\/03\/IsOrtaklarimiz.jpg\" width=\"1280\" height=\"532\" srcset=\"http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/IsOrtaklarimiz.jpg 1280w, http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/IsOrtaklarimiz-300x124.jpg 300w, http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/IsOrtaklarimiz-1024x425.jpg 1024w, http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/IsOrtaklarimiz-870x361.jpg 870w\" sizes=\"(max-width: 1280px) 100vw, 1280px\" \/><\/a><\/p>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"open","ping_status":"open","template":"","meta":[],"_links":{"self":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/pages\/12"}],"collection":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/pages"}],"about":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"http:\/\/Pozitifelektrik.org\/?rest_route=%2Fwp%2Fv2%2Fcomments&post=12"}],"version-history":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/pages\/12\/revisions"}],"wp:attachment":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=%2Fwp%2Fv2%2Fmedia&parent=12"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7,"date":"2014-03-25T12:11:32","date_gmt":"2014-03-25T12:11:32","guid":{"rendered":"http:\/\/localhost\/Pozitifelektrik.org\/?page_id=7"},"modified":"2014-03-25T13:58:30","modified_gmt":"2014-03-25T13:58:30","slug":"hakkimizda","status":"publish","type":"page","link":"http:\/\/Pozitifelektrik.org\/?page_id=7","title":{"rendered":"Hakk\u0131m\u0131zda"},"content":{"rendered":"<address><span style=\"font-size: large;\"><strong>\u015eirketimiz 15 y\u0131ll\u0131k tecr\u00fcbenin ard\u0131ndan, 2005 y\u0131l\u0131nda kurulmu\u015f olan gen\u00e7 bir firmad\u0131r. Denizcilik sekt\u00f6r\u00fcnde Elektrik ve Elektronik proje, donat\u0131m, bak\u0131m&amp;onar\u0131m, servis hizmetleri vermektedir.<\/strong><\/span><\/address>\n<address><span style=\"font-size: large;\"><strong>Kuruldu\u011fumuz g\u00fcnden bu g\u00fcne ilk hedefimiz kaliteli hizmeti ilke edinip, teknolojiyi takip ederek yat elektrik donan\u0131m\u0131nda projeye \u00f6zel h\u0131zl\u0131 ve g\u00fcvenli \u00e7\u00f6z\u00fcmler sunmakt\u0131r.<\/strong><\/span><\/address>\n<address><span style=\"font-size: large;\"><strong>D\u00fcnyaca \u00fcnl\u00fc markalar\u0131n sat\u0131\u015f ve servis hizmetlerinde g\u00f6sterdi\u011fimiz performansla\u00a0 sekt\u00f6rde sa\u011flam ve emin ad\u0131mlarla ilerlemekteyiz.<\/strong><\/span><\/address>\n","protected":false},"excerpt":{"rendered":"<p>\u015eirketimiz 15 y\u0131ll\u0131k tecr\u00fcbenin ard\u0131ndan, 2005 y\u0131l\u0131nda kurulmu\u015f olan gen\u00e7 bir firmad\u0131r. Denizcilik sekt\u00f6r\u00fcnde Elektrik ve Elektronik proje, donat\u0131m, bak\u0131m&amp;onar\u0131m, servis hizmetleri vermektedir. Kuruldu\u011fumuz g\u00fcnden bu g\u00fcne ilk hedefimiz kaliteli hizmeti ilke edinip, teknolojiyi takip ederek yat elektrik donan\u0131m\u0131nda projeye \u00f6zel h\u0131zl\u0131 ve g\u00fcvenli \u00e7\u00f6z\u00fcmler sunmakt\u0131r. D\u00fcnyaca \u00fcnl\u00fc markalar\u0131n sat\u0131\u015f ve servis hizmetlerinde g\u00f6sterdi\u011fimiz performansla\u00a0&#8230;  <a class=\"excerpt-read-more\" href=\"http:\/\/Pozitifelektrik.org\/?page_id=7\" title=\"ReadHakk\u0131m\u0131zda\">Read more &raquo;<\/a><\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"open","ping_status":"open","template":"","meta":[],"_links":{"self":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/pages\/7"}],"collection":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/pages"}],"about":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"http:\/\/Pozitifelektrik.org\/?rest_route=%2Fwp%2Fv2%2Fcomments&post=7"}],"version-history":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=\/wp\/v2\/pages\/7\/revisions"}],"wp:attachment":[{"href":"http:\/\/Pozitifelektrik.org\/?rest_route=%2Fwp%2Fv2%2Fmedia&parent=7"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":5,"date":"2014-03-25T12:10:05","date_gmt":"2014-03-25T12:10:05","guid":{"rendered":"http:\/\/localhost\/Pozitifelektrik.org\/?page_id=5"},"modified":"2014-03-28T09:26:31","modified_gmt":"2014-03-28T09:26:31","slug":"ana-sayfa","status":"publish","type":"page","link":"http:\/\/Pozitifelektrik.org\/","title":{"rendered":"Ana Sayfa"},"content":{"rendered":"<div class=\"img\" style=\"background-image: url(http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/Ana001.jpg); display:none;\"><\/div><div class=\"img\" style=\"background-image: url(http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/Ana002.jpg); display:none;\"><\/div><div class=\"img\" style=\"background-image: url(http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/Ana003.jpg); display:none;\"><\/div><div class=\"img\" style=\"background-image: url(http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/Ana004.jpg); display:none;\"><\/div><div class=\"img\" style=\"background-image: url(http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/Ana005.jpg); display:none;\"><\/div><div class=\"img\" style=\"background-image: url(http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/Ana006.jpg); display:none;\"><\/div><div class=\"img\" style=\"background-image: url(http:\/\/Pozitifelektrik.org\/wp-content\/uploads\/2014\/03\/Ana007.jpg); display:none;\"><\/div>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author"